# Copy to tools/secrets.env (gitignored) and fill in. Never commit the real file.
# SSH host (alias from ~/.ssh/config or user@host) used to upload firmware to the server
VPS_SSH=my-vps
# Public hostname/IP of the server, as the device reaches it over cellular
VPS_HOST=vps.example.com
# MQTT broker (usually the same server)
MQTT_HOST=vps.example.com
MQTT_PORT=1883
# Bench/backend MQTT user (may read all devices/#)
MQTT_USER=dev
MQTT_PASS=CHANGE_ME
# Device id = its MQTT client id and username; ACL limits it to devices/<id>/#
DEVICE_ID=bike-01
DEVICE_MQTT_PASS=CHANGE_ME
# Firmware HTTP server port and the random directory the images live under
# (generate with: python3 -c "import secrets; print(secrets.token_hex(16))")
OTA_PORT=8080
OTA_TOKEN=CHANGE_ME
